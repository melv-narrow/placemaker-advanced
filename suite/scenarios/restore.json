        {
          "do": "setting",
          "name": "RestoreLandOnRemove",
          "value": true
        },
        {
          "do": "area",
          "tool": "bucket"
        },
        {
          "do": "type",
          "layer": "stripMall",
          "preset": "classic"
        },
        {
          "do": "entrances"
        },
        {
          "do": "preview"
        },
